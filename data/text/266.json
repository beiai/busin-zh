{
  "chunk": 266,
  "base": "0x3C9B000",
  "align": "center",
  "messages": [
    {
      "offset": "0x0002",
      "show": "screen",
      "source": "美しい女王の下",
      "text": ["在美丽女王治下"]
    },
    {
      "offset": "0x0012",
      "show": "screen",
      "source": "平和の時をまどろんでいた",
      "text": ["沉浸在和平时光中的"]
    },
    {
      "offset": "0x002C",
      "show": "screen",
      "source": "聖都ドゥーハン",
      "text": ["圣都杜汉"]
    },
    {
      "offset": "0x003C",
      "show": "screen",
      "source": "しかし",
      "text": ["然而"]
    },
    {
      "offset": "0x0044",
      "show": "screen",
      "source": "ある日、天から\nふりそそいだ閃光により\n全てが焼きつくされた",
      "text": ["一日、天降闪光", "倾泻而下的光芒", "将一切烧成了灰烬"]
    },
    {
      "offset": "0x0082",
      "show": "screen",
      "source": "舞散る雪に閉ざされている",
      "text": ["封闭在飞舞的雪中"]
    },
    {
      "offset": "0x009C",
      "show": "screen",
      "source": "物語の幕が……\n静かにあがろうとしていた",
      "text": ["故事的帷幕……", "正要静静地升起"]
    },
    {
      "offset": "0x00C6",
      "show": "screen",
      "source": "その美しさを\nたたえられた城も……",
      "text": ["因那份美丽", "受人称颂的城也……"]
    },
    {
      "offset": "0x00EA",
      "show": "screen",
      "source": "人々でにぎわっていた\n城下街も……",
      "text": ["曾满是人群的", "城下街也……"]
    },
    {
      "offset": "0x010E",
      "show": "screen",
      "source": "ある日、一人の冒険者が\nこの地に足を踏み入れた",
      "text": ["一日、一个冒险者", "踏入了这片土地"]
    },
    {
      "offset": "0x013E",
      "show": "screen",
      "source": "ドゥーハンの街をみわたす\n冒険者のそのまなざしは\nどこかうつろで\nふしぎな哀しみに満ちている",
      "text": ["眺望着杜汉的街道", "冒险者的目光", "有些空洞", "充满莫名的哀伤"]
    },
    {
      "offset": "0x019C",
      "show": "screen",
      "source": "冒険者は、たよりなげな足取りで\n街中をゆっくりと歩きはじめた",
      "text": ["冒险者迈着虚浮的脚步", "在街中慢慢走起来"]
    }
  ]
}
