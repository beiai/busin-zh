    {
      "type": "dialog",
      "source": "ゾンビ\n<FB03>  ニモツ…オオスギ…ダメ…ダメヨ…<FB02>",
      "text": [
        "僵尸",
        "<FB03>东西…太多…不行…不行呀…<FB02>"
      ]
    },
    {
      "type": "center",
      "source": "他にも何か買いますか？\n\n<FFC0>は い\n<FFC1>いいえ\n",
      "text": [
        "还要买别的吗？",
        "",
        "<FFC0>是",
        "<FFC1>否",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「おぉっ！\n<FFD3>久しぶりだねぇ！」",
      "text": [
        "露天商「哦哦！",
        "<FFD3>好久不见啊！」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「まさか、こんな所で会うとは\n<FFD3>思ってもみなかったよ」",
      "text": [
        "露天商「竟在这种地方遇见你，",
        "<FFD3>想都没想过啊」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「俺は最近ちょくちょく、\n<FFD3>この辺まで商売しに\n<FFD3>来てるんだ」",
      "text": [
        "露天商「我最近常常",
        "<FFD3>来到这一带",
        "<FFD3>做生意」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「どうだい、\n<FFD3>何か見ていくかい？」",
      "text": [
        "露天商「怎么样，",
        "<FFD3>要看点什么吗？」"
      ]
    },
    {
      "type": "center",
      "source": "買い物をしますか？\n\n<FFC0>は い\n<FFC1>いいえ\n",
      "text": [
        "要买东西吗？",
        "",
        "<FFC0>是",
        "<FFC1>否",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「んじゃ、まあ\n<FFD3>また見かけたらよろしくな！」",
      "text": [
        "露天商「那就这样，",
        "<FFD3>再碰见了多关照啊！」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「んじゃ、まあ\n<FFD3>また見かけたらよろしくな！」",
      "text": [
        "露天商「那就这样，",
        "<FFD3>再碰见了多关照啊！」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「おっ！\n<FFD3>また会ったな！」",
      "text": [
        "露天商「哦！",
        "<FFD3>又见面了啊！」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「どうだい、\n<FFD3>何か見ていくかい？」",
      "text": [
        "露天商「怎么样，",
        "<FFD3>要看点什么吗？」"
      ]
    },
    {
      "type": "center",
      "source": "買い物をしますか？\n\n<FFC0>は い\n<FFC1>いいえ\n",
      "text": [
        "要买东西吗？",
        "",
        "<FFC0>是",
        "<FFC1>否",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「んじゃ、まあ\n<FFD3>また見かけたらよろしくな！」",
      "text": [
        "露天商「那就这样，",
        "<FFD3>再碰见了多关照啊！」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「んじゃ、まあ\n<FFD3>また見かけたらよろしくな！」",
      "text": [
        "露天商「那就这样，",
        "<FFD3>再碰见了多关照啊！」"
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>     イラッシャイマシ…\n<STYLE:3>ホテル・ラヴ<STYLE:1>♥<STYLE:3>コープス<STYLE:0>へヨウコソ…",
      "text": [
        "腐尸",
        "<FB03>欢迎光临…",
        "<STYLE:3>欢迎来到恋尸<STYLE:1>♥<STYLE:3>旅馆<STYLE:0>…"
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>  休憩ハ、二時間3000ゴールド\n     宿泊ハ、ヤッテナイ",
      "text": [
        "腐尸",
        "<FB03>休息是，两小时3000金币",
        "     住宿是，不做"
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>  宿泊ナイカラ、レベルアップ無理\n     ダケド、ピンピンヨ",
      "text": [
        "腐尸",
        "<FB03>没住宿，等级升不了",
        "     不过，照样很精神呀"
      ]
    },
    {
      "type": "center",
      "source": "休憩していきますか？\n\n<FFC0>は い\n<FFC1>いいえ\n",
      "text": [
        "要在这里休息吗？",
        "",
        "<FFC0>是",
        "<FFC1>否",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>   ソ…添イ寝…シテホシイ…？",
      "text": [
        "腐尸",
        "<FB03>陪…陪睡…想要吗…？"
      ]
    },
    {
      "type": "center",
      "source": "添い寝して欲しいですか？\n\n<FFC0>は い\n<FFC1>いいえ\n",
      "text": [
        "想要陪睡吗？",
        "",
        "<FFC0>是",
        "<FFC1>否",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>   マ…マタ今度…待ッテルワ…",
      "text": [
        "腐尸",
        "<FB03>下…下次…等着你呀…"
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>    ソンナ…ダ…ダメヨ……",
      "text": [
        "腐尸",
        "<FB03>那样…不…不行呀……"
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>      エ…エッチ…",
      "text": [
        "腐尸",
        "<FB03>色…色色…"
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>     3000ゴールド…\n     モラットイタカラ…",
      "text": [
        "腐尸",
        "<FB03>3000金币…",
        "     收过了…所以…"
      ]
    },
    {
      "type": "dialog",
      "source": "ロッティングコープス\n<FB03>      マタ…キテネ…",
      "text": [
        "腐尸",
        "<FB03>再…来呀…"
      ]
    },
    {
      "type": "dialog",
