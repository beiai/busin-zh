  "messages": [
    {
      "type": "dialog",
      "source": "ゾンビ\n<FB03>モ…モシ…モシモシ……？<FB02>",
      "text": [
        "僵尸",
        "<FB03>喂…喂…喂喂……？<FB02>"
      ]
    },
    {
      "type": "center",
      "source": "ゾンビが話し掛けて来た<BREAK>",
      "text": [
        "僵尸向你搭话了。<BREAK>"
      ]
    },
    {
      "type": "center",
      "source": "応対しますか？\n\n用件を聞く\n無視する\n",
      "text": [
        "要回应吗？",
        "",
        "听来意",
        "无视",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "ゾンビ\n<FB03>ク…クスリ…クスリヤ…\nゾンビング…ファーマシー……<FB02>",
      "text": [
        "僵尸",
        "<FB03>药…药…药铺…",
        "丧宾…药房……<FB02>"
      ]
    },
    {
      "type": "dialog",
      "source": "ゾンビ\n<FB03>クスリ……ウル…ウリマス…\nウラセテ…イタダキマス…<FB02>",
      "text": [
        "僵尸",
        "<FB03>药……卖…我卖…",
        "请让…我卖…<FB02>"
      ]
    },
    {
      "type": "dialog",
      "source": "ゾンビ\n<FB03>クスリ…カエ…カッテ…\nカッテ…イタダケマセンカ…？<FB02>",
      "text": [
        "僵尸",
        "<FB03>药…买…买下…",
        "买下…可以吗…？<FB02>"
      ]
    },
    {
      "type": "center",
      "source": "薬を買いますか？\n\nは い\nいいえ\n",
      "text": [
        "要买药吗？",
        "",
        "是",
        "否",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "ゾンビ\n<FB03>ク…クスリ…クスリヤ…\nゾンビング…ファーマシー……<FB02>",
      "text": [
        "僵尸",
        "<FB03>药…药…药铺…",
        "丧宾…药房……<FB02>"
      ]
    },
