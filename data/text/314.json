      ]
    },
    {
      "type": "center",
      "source": "他にも何か買いますか？\n\nは い\nいいえ\n",
      "text": [
        "还要买别的吗？",
        "",
        "是",
        "否",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「おぉっ！\n久しぶりだねぇ！」",
      "text": [
        "露天商「哦哦！",
        "好久不见啊！」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「まさか、こんな所で会うとは\n思ってもみなかったよ」",
      "text": [
        "露天商「竟在这种地方遇见你，",
        "想都没想过啊」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「俺は最近ちょくちょく、\nこの辺まで商売しに\n来てるんだ」",
      "text": [
        "露天商「我最近常常",
        "来到这一带",
        "做生意」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「どうだい、\n何か見ていくかい？」",
      "text": [
        "露天商「怎么样，",
        "要看点什么吗？」"
      ]
    },
    {
      "type": "center",
      "source": "買い物をしますか？\n\nは い\nいいえ\n",
      "text": [
        "要买东西吗？",
        "",
        "是",
        "否",
        ""
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「んじゃ、まあ\nまた見かけたらよろしくな！」",
      "text": [
        "露天商「那就这样，",
        "再碰见了多关照啊！」"
      ]
    },
    {
      "type": "dialog",
      "source": "露天商「んじゃ、まあ\nまた見かけたらよろしくな！」",
