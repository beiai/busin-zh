[
  {
    "id": "00 443538",
    "source": "いらっしゃい",
    "text": "欢迎光临"
  },
  {
    "id": "01 443548",
    "source": "あら? あなた…/はじめて見る方ね…",
    "text": "哎呀？ 你…/我还是头一回见…"
  },
  {
    "id": "02 443570",
    "source": "ここは魔法石の合成や/分解をする所よ",
    "text": "这里是做魔法石合成或/分解的地方"
  },
  {
    "id": "03 443598",
    "source": "で…/どんなご用かしら?",
    "text": "那么…/有什么事呢？"
  },
  {
    "id": "04 4435B8",
    "source": "まずは どの柔材を/選ばれるのかしら?",
    "text": "先选哪种/柔材呢？"
  },
  {
    "id": "05 4435E0",
    "source": "次は どの柔材を/選ばれるのかしら?",
    "text": "接着选哪种/柔材呢？"
  },
  {
    "id": "06 443608",
    "source": "その組み合わせだと/{10}が/できますわね",
    "text": "这样组合的话/{10}/就能做出来呢"
  },
  {
    "id": "07 443648",
    "source": "どの魔法石を/分解されるのかしら?",
    "text": "哪一颗魔法石/要分解吗？"
  },
  {
    "id": "08 443670",
    "source": "どの羊皮紙に書かれた/合成をしたいのかしら?",
    "text": "哪张羊皮纸上的/合成要做吗？"
  },
  {
    "id": "09 4436A0",
    "source": "羊皮紙をお持ちでないと/羊皮紙合成はできないわ",
    "text": "没带羊皮纸就/做不了羊皮纸合成"
  },
  {
    "id": "0A 4436D0",
    "source": "その合成をするには/柔材が足りないようね…",
    "text": "要做这个合成/柔材好像不够…"
  },
  {
    "id": "0B 443700",
    "source": "その魔法石は/私の力では/分解できませんわ…",
    "text": "这颗魔法石/以我的力量/分解不了…"
  },
  {
    "id": "0C 443730",
    "source": "分解出来る物は/お持ちでないようね",
    "text": "能分解的东西/你好像没带着"
  },
  {
    "id": "0D 443758",
    "source": "あら… ごめんあそばせ/うまく分解できなかった/みたいね…",
    "text": "哎呀… 请见谅/好像没能分解好…"
  },
  {
    "id": "0E 443798",
    "source": "まぁ… めずらしい/{10}が/できたみたいね",
    "text": "嗯…少见的/{10}/好像做出来了"
  },
  {
    "id": "0F 4437D8",
    "source": "また いらしてね",
    "text": "还请再来"
  },
  {
    "id": "10 4437F0",
    "source": "合成がしたければ/2つ以上の柔材を/集めてくることね",
    "text": "想合成的话/两种以上的柔材/收集来吧"
  },
  {
    "id": "11 443828",
    "source": "あら…/持ち物が多すぎる/みたいね",
    "text": "哎呀…/东西好像/太多了"
  },
  {
    "id": "12 443850",
    "source": "合成をはじめても/よろしいかしら?",
    "text": "现在开始合成/可以吗？"
  },
  {
    "id": "13 443878",
    "source": "まだ合成するつもり?",
    "text": "还打算合成吗？"
  },
  {
    "id": "14 443890",
    "source": "まだ分解するつもり?",
    "text": "还打算分解吗？"
  },
  {
    "id": "15 4438A8",
    "source": "分解してもアイテムを/1つしか持てないけど/いいのかしら?",
    "text": "就算分解/物品也只能拿一个/可以吗？"
  },
  {
    "id": "16 4438E8",
    "source": "{10}/ができたわよ。",
    "text": "{10}/做好了。"
  },
  {
    "id": "17 443910",
    "source": "代わりになにか/持ち物を捨てますの?",
    "text": "要丢掉别的/哪件物品吗？"
  },
  {
    "id": "18 443938",
    "source": "では、どちらのアイテムを/持っていきますの?",
    "text": "那么，哪件物品/你要带走？"
  },
  {
    "id": "19 443968",
    "source": "では{10}/はあきらめるのね?",
    "text": "那么{10}/要放弃了吗？"
  },
  {
    "id": "1A 443998",
    "source": "{10}を/捨ててもよろしいの?",
    "text": "{10}/丢掉可以吗？"
  },
  {
    "id": "1B 4439C8",
    "source": "分解をはじめても/よろしいかしら?",
    "text": "现在开始分解/可以吗？"
  },
  {
    "id": "1C 4439F0",
    "source": "あら…羊皮紙を/持っているのね/では、あずかっておくわ",
    "text": "哎呀…羊皮纸/你带着呢/那么，我先替你收着"
  },
  {
    "id": "1D 443A28",
    "source": "__________",
    "text": "__________"
  },
  {
    "id": "1E 443A40",
    "source": "では、/{7}さんに/お渡ししておくわね",
    "text": "那么，/交给{7}了"
  },
  {
    "id": "1F 443A78",
    "source": "魔術師魔法",
    "text": "魔法师魔法"
  },
  {
    "id": "20 443A88",
    "source": "僧侶魔法",
    "text": "僧侣魔法"
  },
  {
    "id": "21 443A98",
    "source": "STOCK{3}",
    "text": "STOCK{3}"
  },
  {
    "id": "22 443AB0",
    "source": "RANK{2}",
    "text": "RANK{2}"
  },
  {
    "id": "23 443AC0",
    "source": "(MAXRANK{3})",
    "text": "(MAXRANK{3})"
  },
  {
    "id": "24 443AE0",
    "source": "()",
    "text": "()"
  },
  {
    "id": "25 443AE8",
    "source": "--",
    "text": "--"
  },
  {
    "id": "26 443AF0",
    "source": "どの魔法石を/作りたいのかしら?",
    "text": "哪一颗魔法石/想做吗？"
  },
  {
    "id": "27 443B18",
    "source": "どの柔材を組み合わせて/合成するのかしら?",
    "text": "要组合哪些柔材/来合成？"
  },
  {
    "id": "28 443B48",
    "source": "x{2}",
    "text": "x{2}"
  },
  {
    "id": "29 443B50",
    "source": "所持{2}",
    "text": "持有{2}"
  },
  {
    "id": "2A 443B60",
    "source": "習得不可",
    "text": "不可习得"
  },
  {
    "id": "2B 443B70",
    "source": "習得可能",
    "text": "可以习得"
  },
  {
    "id": "2C 443B80",
    "source": "今すぐ魔法石を/お使いになるかしら?",
    "text": "现在就要用/魔法石吗？"
  },
  {
    "id": "2D 443BA8",
    "source": "誰もその魔法を/習得できないようね",
    "text": "这个魔法/似乎谁都无法习得"
  },
  {
    "id": "2E 443BD0",
    "source": "{10}の魔法を習得した!",
    "text": "习得了{10}的魔法！"
  },
  {
    "id": "2F 443BF8",
    "source": "{10}の魔法がランクアップした!",
    "text": "{10}的魔法阶级提升了！"
  },
  {
    "id": "30 443C28",
    "source": "{10}の魔法石が壊れた",
    "text": "{10}的魔法石坏了"
  },
  {
    "id": "31 443C50",
    "source": "誰が持つのかしら?",
    "text": "谁来拿着好？"
  },
  {
    "id": "32 443C68",
    "source": "魔術師魔法は/1つも作れませんわよ",
    "text": "魔法师魔法/一个都做不出啊"
  },
  {
    "id": "33 443C90",
    "source": "僧侶魔法は/1つも作れませんわよ",
    "text": "僧侣魔法/一个都做不出啊"
  },
  {
    "id": "34 443CB8",
    "source": "魔法は/1つも作れませんわよ",
    "text": "魔法/一个都做不出啊"
  },
  {
    "id": "35 443CD8",
    "source": "呪われたアイテムは/外せませんわよ",
    "text": "被诅咒的物品/卸不下来啊"
  },
  {
    "id": "36 443D00",
    "source": "MASTER",
    "text": "MASTER"
  },
  {
    "id": "37 443D40",
    "source": "新顔だな/ここはヴィガー商店/武具と魔法石の店だ",
    "text": "新面孔啊/这里是维加商店/武具和魔法石的店"
  },
  {
    "id": "38 443D78",
    "source": "俺は武器や防具といった/武具の売買 鑑定 それに/呪われた装備を外せる",
    "text": "我做武器或防具这类/武具的买卖 鉴定 还有/能卸下被诅咒的装备"
  },
  {
    "id": "39 443DC0",
    "source": "魔法石は女房の仕事だ/合成で魔法石を作ったり/逆に分解もできる",
    "text": "魔法石是老婆的活/能合成出魔法石/反过来也能分解"
  },
  {
    "id": "3A 443E00",
    "source": "あんたが迷宮に挑むなら/武具も 魔法石も/かかせない力になるはずだ",
    "text": "你要闯迷宫的话/武具也好 魔法石也好/都是少不了的力量"
  },
  {
    "id": "3B 443E48",
    "source": "質のいい装備は/生き残る確率を上げるし",
    "text": "品质好的装备/能提高活命几率"
  },
  {
    "id": "3C 443E70",
    "source": "新たな魔法は/魔法石で習得するしか/方法がないからな",
    "text": "新魔法/只能用魔法石习得/没别的办法"
  },
  {
    "id": "3D 443EA8",
    "source": "とにかくひいきに頼むぜ/あんたらにクイーンの/祝福がありますように!",
    "text": "总之多光顾啊/愿你们得到/女王的祝福！"
  },
  {
    "id": "3E 443EF0",
    "source": "おう いらっしゃい!/今回はどんな用だ?",
    "text": "哟 来了！/这回什么事？"
  },
  {
    "id": "3F 443F20",
    "source": "武器 防具 装飾品/いずれ劣らぬ品ばかりだ",
    "text": "武器 防具 装饰品/没有一件是差的"
  },
  {
    "id": "40 443F50",
    "source": "武器は職業によって/装備できるものが/大きく異なるぞ",
    "text": "武器能装哪些/得看职业/差得远了"
  },
  {
    "id": "41 443F88",
    "source": "防具は職業によって/装備できるものが/大きく異なるぞ",
    "text": "防具能装哪些/得看职业/差得远了"
  },
  {
    "id": "42 443FC0",
    "source": "装飾品は 誰でも1つ/装備することができる",
    "text": "装饰品谁都能/装备一件"
  },
  {
    "id": "43 443FF0",
    "source": "これは/{6}Gだが/買うか?",
    "text": "这个/{6}G啊/买不买？"
  },
  {
    "id": "44 444018",
    "source": "おいおい 金が足りねぇな/それじゃ売れねえよ",
    "text": "喂喂 钱不够啊/这样卖不了"
  },
  {
    "id": "45 444048",
    "source": "おいおい 金が足りねぇな",
    "text": "喂喂 钱不够啊"
  },
  {
    "id": "46 444068",
    "source": "まいどあり!",
    "text": "多谢惠顾！"
  },
  {
    "id": "47 444078",
    "source": "誰のアイテムを/売ってもらえるんだ?",
    "text": "谁的物品/卖给我啊？"
  },
  {
    "id": "48 4440A0",
    "source": "どのアイテムを/売ってもらえるんだ?",
    "text": "哪件物品/卖给我啊？"
  },
  {
    "id": "49 4440C8",
    "source": "それは装備しているけど/売ってもらっていいのか?",
    "text": "这件你装备着/卖掉也行吗？"
  },
  {
    "id": "4A 444100",
    "source": "呪われた物を装備したな!/そいつはもう引き取れねぇ/呪いを解くしか手がないぜ",
    "text": "你装备了诅咒物品！/这件已经卸不下来/只能解咒了"
  },
  {
    "id": "4B 444150",
    "source": "そいつは未鑑定だが/売ってもらっていいのか?",
    "text": "这件还没鉴定/卖掉也行吗？"
  },
  {
    "id": "4C 444180",
    "source": "そいつは/{6}Gだな/売ってもらえるか?",
    "text": "这件/{6}G啊/卖不卖？"
  },
  {
    "id": "4D 4441B8",
    "source": "ほい 代金だ/まいどどうも!",
    "text": "喏 这是货款/多谢惠顾！"
  },
  {
    "id": "4E 4441D8",
    "source": "誰のアイテムを/鑑定するんだ?",
    "text": "谁的物品/要鉴定？"
  },
  {
    "id": "4F 4441F8",
    "source": "どのアイテムを/鑑定するんだ?",
    "text": "哪件物品/要鉴定？"
  },
  {
    "id": "50 444218",
    "source": "そのアイテムは/もう鑑定されているぞ",
    "text": "这件物品/已经鉴定过了"
  },
  {
    "id": "51 444240",
    "source": "ふむ 鑑定代は/{6}Gかかるが/鑑定するか?",
    "text": "嗯 鉴定费/{6}G/要鉴定吗？"
  },
  {
    "id": "52 444278",
    "source": "鑑定結果だ/望みのアイテムだったか?",
    "text": "鉴定结果/是想要的货吗？"
  },
  {
    "id": "53 4442A0",
    "source": "まだ鑑定してほしい物が/あるか?",
    "text": "还有要鉴定的/东西吗？"
  },
  {
    "id": "54 4442C8",
    "source": "誰のアイテムの/呪いを解くんだ?",
    "text": "谁的物品/要解咒？"
  },
  {
    "id": "55 4442F0",
    "source": "どのアイテムの/呪いを解くんだ?",
    "text": "哪件物品/要解咒？"
  },
  {
    "id": "56 444318",
    "source": "そのアイテムは/呪いをもたらしてないぞ",
    "text": "这件物品/没有诅咒"
  },
  {
    "id": "57 444340",
    "source": "そのアイテムを外すには/{6}Gかかるな/かまわないか?",
    "text": "卸下这件要/{6}G啊/不介意吧？"
  },
  {
    "id": "58 444380",
    "source": "呪いはとけたが/ただのがらくたになったな/こっちで捨てておくぜ",
    "text": "诅咒是解开了/不过成了破烂/我替你扔掉"
  },
  {
    "id": "59 4443C0",
    "source": "まだ呪いを解いてほしい/アイテムはあるのか?",
    "text": "还有要解咒的/物品吗？"
  },
  {
    "id": "5A 4443F0",
    "source": "まだほかに/用があるかい?",
    "text": "还有别的/要办吗？"
  },
  {
    "id": "5B 444410",
    "source": "誰もアイテムがいっぱいで/持てないみたいだな",
    "text": "大家都满了/看来拿不下啊"
  },
  {
    "id": "5C 444440",
    "source": "誰に持たせるんだい?",
    "text": "让谁拿着？"
  },
  {
    "id": "5D 444458",
    "source": "おっと、羊皮紙か/それならウチのかみさんに/あずけておくぜ!",
    "text": "哦，羊皮纸啊/那交给我家老婆/先收着！"
  },
  {
    "id": "5E 444498",
    "source": "その人は装備できないが/かまわないか?",
    "text": "这人装备不了/不介意吧？"
  },
  {
    "id": "5F 4444C0",
    "source": "今すぐ装備するかい?",
    "text": "现在就装备吗？"
  },
  {
    "id": "60 4444D8",
    "source": "それは呪われた/アイテムだが/装備するのか?",
    "text": "那是被诅咒的/物品/要装备吗？"
  },
  {
    "id": "61 444508",
    "source": "盾は外れるが/かまわないか?",
    "text": "盾牌会被卸下/不介意吧？"
  },
  {
    "id": "62 444528",
    "source": "呪われたアイテムは/外せないな……",
    "text": "被诅咒的物品/卸不下来……"
  },
  {
    "id": "63 444550",
    "source": "みごとに呪われたな/それでよかったのか?",
    "text": "咒得真彻底/这样好吗？"
  },
  {
    "id": "64 444580",
    "source": "武器は外れるが/かまわないか?",
    "text": "武器会被卸下/不介意吧？"
  },
  {
    "id": "65 4445A0",
    "source": "呪われたアイテムのせいで/今は装備できないが/かまわないか?",
    "text": "因为诅咒物品/现在装备不了/不介意吧？"
  },
  {
    "id": "66 444760",
    "source": "短 刀",
    "text": "短 刀"
  },
  {
    "id": "67 444768",
    "source": "小 剣",
    "text": "短 剑"
  },
  {
    "id": "68 444770",
    "source": "長 剣",
    "text": "长 剑"
  },
  {
    "id": "69 444778",
    "source": "大 剣",
    "text": "大 剑"
  },
  {
    "id": "6A 444780",
    "source": "刀",
    "text": " 刀 "
  },
  {
    "id": "6B 444788",
    "source": "杖",
    "text": "法 杖"
  },
  {
    "id": "6C 444790",
    "source": "メイス",
    "text": "钉 锤"
  },
  {
    "id": "6D 444798",
    "source": "手 斧",
    "text": "手 斧"
  },
  {
    "id": "6E 4447A0",
    "source": "戦 斧",
    "text": "战 斧"
  },
  {
    "id": "6F 4447A8",
    "source": "手裏剣",
    "text": "手里剑"
  },
  {
    "id": "70 4447B0",
    "source": "石 弓",
    "text": " 弩 "
  },
  {
    "id": "71 4447B8",
    "source": "フレイル",
    "text": "连 枷"
  },
  {
    "id": "72 4447C8",
    "source": "なげナイフ",
    "text": "飞 刀"
  },
  {
    "id": "73 4447D8",
    "source": "ローブ",
    "text": "长 袍"
  },
  {
    "id": "74 4447E0",
    "source": "皮 鎧",
    "text": "皮 甲"
  },
  {
    "id": "75 4447E8",
    "source": "鎖かたびら",
    "text": "锁子甲"
  },
  {
    "id": "76 4447F8",
    "source": "胸あて",
    "text": "胸 甲"
  },
  {
    "id": "77 444800",
    "source": "全身鎧",
    "text": "全身铠"
  },
  {
    "id": "78 444808",
    "source": "兜",
    "text": "头 盔"
  },
  {
    "id": "79 444810",
    "source": "盾",
    "text": "盾 牌"
  },
  {
    "id": "7A 444818",
    "source": "小手",
    "text": "护 手"
  },
  {
    "id": "7B 444820",
    "source": "装備可能:",
    "text": "可装备:"
  },
  {
    "id": "7C 444830",
    "source": "戦騎侍忍盗僧司魔",
    "text": "战骑武忍盗僧主魔"
