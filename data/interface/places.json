  {
    "id": "567FA8",
    "source": "宝箱をあきらめました",
    "text": "放弃了宝箱"
  },
  {
    "id": "567FC0",
    "source": "誰が開けますか?",
    "text": "谁来打开？"
  },
  {
    "id": "567FD8",
    "source": "カギが掛かっているようだ。",
    "text": "好像上了锁。"
  },
  {
    "id": "567FF8",
    "source": "カギを開けますか?",
    "text": "要开锁吗？"
  },
  {
    "id": "568010",
    "source": "失敗!",
    "text": "失败！"
  },
  {
    "id": "568018",
    "source": "のトラップが",
    "text": "的陷阱"
  },
  {
    "id": "568028",
    "source": "それでも開けますか?",
    "text": "即便如此也要打开吗？"
  },
  {
    "id": "568040",
    "source": "のトラップと",
    "text": "的陷阱和"
  },
  {
    "id": "568050",
    "source": "それでも開けますか?",
    "text": "即便如此也要打开吗？"
  },
  {
    "id": "568068",
    "source": "宝箱の中は空っぽだ。",
    "text": "宝箱里是空的。"
  },
  {
    "id": "568080",
