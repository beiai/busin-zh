    "id": "569C30",
    "source": "恐怖を乗りこえ/たい",
    "text": "想克服/恐惧"
  },
  {
    "id": "569C48",
    "source": "信頼というもの/を教えて欲しい",
    "text": "请告诉我/何谓信任"
  },
  {
    "id": "569C68",
    "source": "恋を叶える/おまじない",
    "text": "让恋情/成真的咒语"
  },
  {
    "id": "569C80",
    "source": "私の恋人を/何とかして",
    "text": "我的恋人/请想想办法"
  },
  {
    "id": "569C98",
    "source": "私の恋人を/どうにかして",
    "text": "我的恋人/请务必管管"
  },
  {
    "id": "569CB8",
    "source": "私を僧侶にして/下さい",
    "text": "请让我/成为僧侣"
  },
  {
    "id": "569CD0",
    "source": "私を司教にして/下さい",
    "text": "请让我/成为主教"
  },
  {
    "id": "569CE8",
    "source": "魔法石屋を/はじめるわ!",
    "text": "魔法石店/我开定了！"
  },
  {
    "id": "569D08",
    "source": "武器屋を/はじめるわ!",
    "text": "武器店/我开定了！"
  },
  {
    "id": "569D20",
    "source": "合成剣を/売っちゃうわ!",
    "text": "合成剑/我来卖啦！"
  },
  {
    "id": "569D40",
    "source": "ルイって女を/さがして欲しい",
    "text": "请去寻找/名叫露易的女人"
  },
  {
    "id": "569D60",
    "source": "斧をとどけ/てくれないか?",
    "text": "能把这把斧/送过去吗？"
  },
  {
    "id": "569D80",
    "source": "ある男の生死を/調べて欲しい",
    "text": "请调查某男子/的生死"
  },
  {
    "id": "569DA0",
    "source": "私が何者だか/教えて欲しい",
    "text": "请告诉我/我是什么人"
  },
  {
    "id": "569DC0",
    "source": "不死の霊薬を/作りたい",
    "text": "我想制作/不死灵药"
  },
  {
    "id": "569DD8",
    "source": "俺の眠りを取り/戻して欲しい",
    "text": "请帮我夺回/睡眠"
  },
  {
    "id": "569DF8",
    "source": "夫を調べてくれ/ません?",
    "text": "请帮我查/我丈夫吗？"
  },
  {
    "id": "569E18",
    "source": "わが隊の盾を取/り戻して欲しい",
    "text": "请帮我夺回/我队的盾"
  },
  {
    "id": "569E38",
    "source": "良い事をして/みてえんだ",
    "text": "我想做件/好事看看"
  },
  {
    "id": "569E58",
    "source": "ハンナって女を/さがしてくれ",
    "text": "请寻找名叫汉娜/的女人"
  },
  {
    "id": "569E78",
    "source": "音楽を取り戻し/て欲しい",
    "text": "请帮我找回/音乐"
  },
  {
    "id": "569E98",
    "source": "ある書物を探し/てくれないか",
    "text": "能帮我找来/某本典籍吗？"
  },
  {
    "id": "569EB8",
    "source": "兄を助けて",
    "text": "救救哥哥"
  },
  {
    "id": "569EC8",
    "source": "めいきゅうに/いってみたいな",
    "text": "人家想去/迷宫看看"
  },
