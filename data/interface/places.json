    "id": "529C80",
    "source": "いらっしゃい!",
    "text": "欢迎光临！"
  },
  {
    "id": "529C90",
    "source": "おっと、わりぃな!/まだ売れるものが/何もねぇんだ",
    "text": "哎呀，对不住！/能卖的东西/一样都没有"
  },
  {
    "id": "529CC8",
    "source": "それは今ちょいと、/キラしちまってんだ!",
    "text": "这东西这会儿，/已经卖光啦！"
  },
  {
    "id": "529CFE",
    "source": "Gになるけど/それを買うか?",
    "text": "G，/要买下吗？"
  },
  {
    "id": "529D20",
    "source": "オマエ、金持ってねぇじゃん!",
    "text": "你这不是没钱吗！"
  },
  {
    "id": "529D40",
    "source": "ありがとよ!",
    "text": "谢谢啦！"
  },
  {
    "id": "529D50",
    "source": "持ち物が多すぎるぜ!/そんなんじゃ、商品を/持っていけねぇぞ",
    "text": "你东西太多了！/这样的话，商品/可带不走啊"
  },
  {
    "id": "529D90",
    "source": "どれを売ってくれるんだい?",
    "text": "你要卖哪个呀？"
  },
  {
    "id": "529DB6",
    "source": "Gでひきとるけど/それでいいか?",
    "text": "G我就收，/这样行吗？"
  },
  {
    "id": "529DD8",
    "source": "なんだよ、合成柔材を1つも/持っていないじゃねぇか。",
    "text": "什么啊，合成材料一个都/没带着啊。"
  },
  {
    "id": "529E10",
    "source": "柔材を買う/柔材を売る/やめる",
    "text": "买材料/卖材料/取消"
  },
  {
    "id": "529E32",
    "source": "はい",
    "text": "是"
  },
  {
    "id": "529E3A",
    "source": "いいえ",
    "text": "否"
  },
  {
    "id": "529E60",
    "source": "おっと、それは準備中だ!",
    "text": "哎呀，那个还在准备！"
  },
  {
    "id": "529E80",
    "source": "おっ、新しい柔材か!/いやあ、助かるねえ!",
    "text": "哦，是新的材料！/哎呀，帮大忙啦！"
  },
  {
    "id": "529EB0",
    "source": "それは悪魔の柔材だな",
    "text": "那是恶魔材料啊"
  },
  {
    "id": "529EC8",
    "source": "それは不死の柔材だな",
    "text": "那是不死材料啊"
  },
  {
    "id": "529EE0",
    "source": "それは巨人の柔材だな",
    "text": "那是巨人材料啊"
  },
  {
    "id": "529EF8",
    "source": "それは竜の柔材だな",
    "text": "那是龙材料啊"
  },
  {
    "id": "529F10",
    "source": "それは動物の柔材だな",
    "text": "那是动物材料啊"
  },
  {
    "id": "529F28",
    "source": "それは昆虫の柔材だな",
    "text": "那是昆虫材料啊"
  },
  {
    "id": "529F40",
    "source": "それは妖精の柔材だな",
    "text": "那是妖精材料啊"
  },
  {
    "id": "529F58",
    "source": "それは戦士の柔材だな",
    "text": "那是战士材料啊"
  },
  {
    "id": "529F70",
    "source": "それは盗賊の柔材だな",
    "text": "那是盗贼材料啊"
  },
  {
    "id": "529F88",
    "source": "それは忍者の柔材だな",
    "text": "那是忍者材料啊"
  },
  {
    "id": "529FA0",
    "source": "それは僧侶の柔材だな",
    "text": "那是僧侣材料啊"
  },
  {
    "id": "529FB8",
    "source": "それは魔術師の柔材だな",
    "text": "那是魔法师材料啊"
  },
  {
    "id": "529FD0",
    "source": "それは侍の柔材だな",
    "text": "那是武士材料啊"
  },
  {
    "id": "529FE8",
    "source": "それは司祭の柔材だな",
    "text": "那是祭司材料啊"
