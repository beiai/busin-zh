    "text": "MP吸取"
  },
  {
    "id": "568118",
    "source": "モンスターは宝箱をもっていました。",
    "text": "怪物带着宝箱。"
  },
  {
    "id": "568140",
    "source": "カギが仕掛けられているようです。",
    "text": "好像在锁上设了机关。"
  },
  {
    "id": "568168",
    "source": "仕掛けられているようです。",
    "text": "好像设有机关。"
  },
  {
    "id": "568188",
    "source": "アイテムを宝箱に戻しました。",
    "text": "已将道具放回宝箱。"
  },
  {
    "id": "5681B0",
    "source": "に渡した。",
    "text": "收到了。"
  },
  {
    "id": "5681C0",
    "source": "これ以上アイテムを、持つことが出来ません。/持ち物の中からアイテムを捨てますか?",
    "text": "无法再持有更多道具。/要从随身物品里丢掉道具吗？"
  },
  {
    "id": "568218",
    "source": "はい",
    "text": "是"
  },
  {
    "id": "568220",
    "source": "いいえ",
    "text": "否"
  },
  {
    "id": "568228",
    "source": "アイテムをあきらめます。",
    "text": "要放弃这件道具。"
  },
  {
    "id": "568248",
    "source": "を捨てますか?",
    "text": "要丢掉吗？"
  },
  {
    "id": "568258",
    "source": "をあきらめますか?",
    "text": "要放弃吗？"
  },
  {
    "id": "568270",
    "source": "を捨てました。",
    "text": "丢掉了。"
  },
  {
    "id": "568280",
    "source": "をあきらめました。",
    "text": "放弃了。"
  },
  {
    "id": "568298",
    "source": "アイテムが入っていました。",
    "text": "里面装着道具。"
  },
  {
    "id": "5682B8",
    "source": "あきらめました。",
    "text": "放弃了。"
  },
